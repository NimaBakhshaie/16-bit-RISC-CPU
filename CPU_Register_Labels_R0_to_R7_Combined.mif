-- Eight 64x32 register labels concatenated into one 3-bit RGB ROM.
-- Labels 0..7 = R0, R1, R2, R3, R4, R5, R6, R7.
-- Black=000; White=111. Row-major pixels within each label.
-- Address = label_index*2048 + y*64 + x.
WIDTH=3;
DEPTH=16384;
ADDRESS_RADIX=HEX;
DATA_RADIX=BIN;
